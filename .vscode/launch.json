{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/launch_training.py",
            "console": "integratedTerminal",
            "name": "BP",
            "args": [
                "--method",
                "bp",
                "--action",
                "${input:trainingAction}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/launch_training.py",
            "console": "integratedTerminal",
            "name": "PC-ALM",
            "args": [
                "--method",
                "pcalm",
                "--output",
                "results/pcalm_lr_only_full",
                "--action",
                "${input:trainingAction}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "trainingAction",
            "type": "pickString",
            "description": "実行方法を選択",
            "options": [
                {
                    "label": "再開：保存したモデルから続ける",
                    "value": "resume"
                },
                {
                    "label": "新規：最初から200 epoch学習",
                    "value": "new"
                }
            ],
            "default": "new"
        }
    ]
}
